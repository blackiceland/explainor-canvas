# fal.ai API key — https://fal.ai/dashboard/keys
FAL_KEY=

# optional: override the assumed price per second of generated video
# OMNI_PRICE_PER_SEC=0.16

# optional: use system ffmpeg instead of the bundled static binaries
# OMNI_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# OMNI_FFPROBE=C:\ffmpeg\bin\ffprobe.exe
